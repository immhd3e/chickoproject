generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  description String        @default("")
  image       String
  sort        Int           @default(0)
  types       ProductType[]
  products    Product[]
  collections Collection[]
}

model ProductType {
  id         Int       @id @default(autoincrement())
  slug       String
  title      String
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, slug])
}

model Product {
  id               Int              @id @default(autoincrement())
  slug             String           @unique
  title            String
  code             String?
  price            Int // تومان
  oldPrice         Int? // قیمت قبل از تخفیف
  image            String
  images           String           @default("[]")
  shortDescription String           @default("")
  description      String           @default("")
  features         String           @default("[]")
  specs            String           @default("[]") // [{label, value}]
  colors           String           @default("[]") // [{name, hex}]
  active           Boolean          @default(true)
  featured         Boolean          @default(false)
  categoryId       Int
  category         Category         @relation(fields: [categoryId], references: [id])
  typeId           Int?
  type             ProductType?     @relation(fields: [typeId], references: [id])
  items            CollectionItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
}

model Collection {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  title       String
  description String           @default("")
  image       String
  banner      String?
  active      Boolean          @default(true)
  sort        Int              @default(0)
  categoryId  Int
  category    Category         @relation(fields: [categoryId], references: [id])
  items       CollectionItem[]
}

model CollectionItem {
  id           Int        @id @default(autoincrement())
  collectionId Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  image        String?
  sort         Int        @default(0)

  @@unique([collectionId, productId])
}

model Portfolio {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  image       String
  images      String   @default("[]")
  location    String   @default("")
  year        String   @default("")
  active      Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
}

model Order {
  id         Int         @id @default(autoincrement())
  code       String      @unique
  name       String
  phone      String
  city       String
  address    String
  postalCode String      @default("")
  note       String      @default("")
  total      Int
  status     String      @default("new")
  items      OrderItem[]
  createdAt  DateTime    @default(now())
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  title     String
  price     Int
  qty       Int
}

model Consultation {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  subject   String
  message   String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
model Slider {
  id        Int      @id @default(autoincrement())
  image     String
  label     String   @default("")
  title     String
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
